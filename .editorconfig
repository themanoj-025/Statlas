# EditorConfig helps maintain consistent coding styles between various
# editors and IDEs. See: https://editorconfig.org/

root = true

# Core file defaults (UTF-8, LF line endings, final newline, no trailing ws)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4

# Markdown (preserve trailing whitespace so hard line breaks render)
[*.md]
trim_trailing_whitespace = false

# YAML / TOML — CI + config
[*.yml]
[*.yaml]
indent_size = 2
[*.toml]
indent_size = 2

# JSON — pyproject, configs
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4

# Makefiles (tab-indented)
[Makefile]
indent_style = tab

# Dockerfiles
[ Dockerfile]
[*.Dockerfile]
indent_size = 2

# Lockfiles — strict alignment, no auto-format
[*.lock]
indent_size = 2
