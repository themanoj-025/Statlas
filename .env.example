# Statlas — local environment (Phase 2 dev run).
# Reference only: config.py reads os.environ (no dotenv loader). Export these
# in your shell/CI, or set them in the run command. All variables are OPTIONAL
# for the fixture-demo run.

# --- Database ---------------------------------------------------------------
# Unset -> in-memory SQLite (tests). For the dev server, point at the seeded
# dev database created by `python scripts/seed_dev_db.py`:
DATABASE_URL=sqlite+pysqlite:///./data/dev.db

# Real production DB would be PostgreSQL (schema.sql owns the DDL):
# DATABASE_URL=postgresql+psycopg2://statlas:secret@localhost:5432/statlas

# --- Honest dataset labeling (Constitution Never-List #9) -------------------
# "fixture-demo" (default) tells the UI to show the dataset banner; set to
# "production" only after a real scrape pipeline run has validated the sources.
STATLAS_DATASET_MODE=fixture-demo
STATLAS_DATASET_NOTE=Serving labeled fixture data from the Phase 1 test fixtures. A full data refresh must run before production launch.

# --- Scrape etiquette (data-compliance-notes.md) ----------------------------
# FBref is rate-limited on purpose; these delays are the compliance floor.
FBREF_DELAY_SECONDS=10.0
FBREF_JITTER_SECONDS=2.0
UNDERSTAT_DELAY_SECONDS=5.0
API_FOOTBALL_DELAY_SECONDS=2.0
API_FOOTBALL_DAILY_BUDGET=80
STATLAS_USER_AGENT=StatlasAnalytics/0.1 (public football analytics; contact: data@statlas.com)
STATLAS_CACHE_DIR=.cache        # HTTP cache dir (sources/base.py)
FBREF_ENRICH_POSITIONS=false    # off by default; slower scrape when on
STATLAS_LOG_LEVEL=INFO

# --- CORS (Phase 19 — production) --------------------------------------------
# Comma-separated list of allowed origins. Defaults to localhost:3000 when
# unset. Production MUST set this to the public domain(s).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Redis (Phase 19 — rate limiting + caching) -------------------------------
# Used for production rate limiting and caching. When unset, the app falls
# back to in-memory (not suitable for multi-worker deployment).
REDIS_URL=redis://localhost:6379/0

# --- Phase 4: Stripe billing (Part A) ----------------------------------------
# All optional: when unset, billing endpoints return an explicit
# "billing not configured" state instead of failing mid-checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_BILLING_PORTAL_ENABLED=false

# --- Phase 4: AI assistant (Part B) ------------------------------------------
# Optional: when unset, the assistant returns an honest "not configured" state.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-3-5-haiku-latest

# --- Phase 4: sessions / cookies ---------------------------------------------
STATLAS_SESSION_COOKIE=statlas_session
STATLAS_SESSION_TTL_HOURS=720
# Set true ONLY on https deployments (production); http dev/test must keep
# the cookie usable.
STATLAS_COOKIE_SECURE=false

# --- Staff access (Phase 18 — analytics dashboards) -------------------------
# Comma-separated list of email addresses granted staff access to the
# internal analytics dashboards. When unset and no Pro subscription exists,
# analytics endpoints return 403.
STAFF_EMAILS=

# --- Optional API keys ------------------------------------------------------
# API-Football free tier (fixtures only in Phase 1). Leave unset to skip.
API_FOOTBALL_KEY=

# --- Outbound email (Phase 10 — Resend) -------------------------------------
# Unset = "email not configured" state; delivery never fails silently.
RESEND_API_KEY=
RESEND_EMAIL_FROM=notifications@statlas.app
# Signs one-click unsubscribe links in alert emails. Production must set it;
a per-process random default keeps dev links safe but invalidates on restart.
ALERT_SIGNING_SECRET=

# --- Web app ----------------------------------------------------------------
# The Next.js app reads the FastAPI layer at these URLs (defaults are fine
# when running both servers locally). In Docker, STATLAS_API_URL points at the
# compose network (set by docker-compose.yml) and NEXT_PUBLIC_STATLAS_API_URL
# is baked at build time from STATLAS_PUBLIC_API_URL.
STATLAS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_STATLAS_API_URL=http://127.0.0.1:8000

# --- Docker (docker-compose.yml) --------------------------------------------
# docker compose interpolates these from .env (defaults shown).
POSTGRES_USER=statlas
POSTGRES_PASSWORD=statlas_dev_password
POSTGRES_DB=statlas
# Browser-facing API URL baked into the web image at build time. Keep it
# reachable from the browser (http://localhost:8000 for a local compose stack;
# your public domain in production).
STATLAS_PUBLIC_API_URL=http://localhost:8000

# --- Environment (Phase 19 — CSRF) ------------------------------------------
# "production" (default) — CSRF enforced on all state-changing requests.
# "test" — CSRF skipped (used by pytest in CI).
STATLAS_ENV=production

# --- Security headers (Phase 19 — CSP) --------------------------------------
# Optional: URI for Content-Security-Policy violation reports.
# When set, adds report-uri directive to the CSP header.
CSP_REPORT_URI=

# --- Public base URL (Phase 10 — alert emails) ------------------------------
# Base URL for one-click unsubscribe links in alert emails.
STATLAS_PUBLIC_BASE_URL=http://localhost:3000
